{
    "Author": "T.J. Lauerman aka ThatSportsGamer",
    "CodePath": "plugin.js",
    "Description": "Shows live NFL scores on your Stream Deck. Track one team per key, or lay out the whole week with the Scoreboard action — score, quarter, clock, and possession at a glance.",
    "Name": "Live NFL Scores",
    "UUID": "com.tj.livenflscores",
    "Category": "Live Sports Scores",
    "URL": "https://github.com/ThatSportsGamer/live-nfl-scores-for-stream-deck",
    "Icon": "imgs/plugin-icon",
    "CategoryIcon": "imgs/category-icon",
    "Version": "1.1.0.0",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "6.9"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "10.15"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "20",
        "Debug": "disabled"
    },
    "Actions": [
        {
            "Name": "Live NFL Scores",
            "UUID": "com.tj.livenflscores.score",
            "Icon": "imgs/action-icon",
            "Tooltip": "Shows live score for your chosen NFL team. Updates every 30 seconds.",
            "PropertyInspectorPath": "property-inspector.html",
            "States": [
                {
                    "Image": "imgs/action-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        },
        {
            "Name": "Live NFL Scoreboard",
            "UUID": "com.tj.livenflscores.scoreboard",
            "Icon": "imgs/scoreboard-icon",
            "Tooltip": "Fills your keys with this week's NFL games, one game per key, in kickoff order.",
            "PropertyInspectorPath": "scoreboard-inspector.html",
            "States": [
                {
                    "Image": "imgs/scoreboard-icon",
                    "Title": ""
                }
            ],
            "SupportedInMultiActions": false
        }
    ]
}